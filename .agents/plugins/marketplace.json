{
  "name": "implicit-core",
  "interface": {
    "displayName": "Implicit Core"
  },
  "plugins": [
    {
      "name": "implicit-core",
      "source": {
        "source": "local",
        "path": "./plugin"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    },
    {
      "name": "implicit-integration",
      "source": {
        "source": "local",
        "path": "./plugins/implicit-integration"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_USE"
      },
      "category": "Developer Tools"
    }
  ]
}
